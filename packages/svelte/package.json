{
  "name": "@theme-toggles/svelte",
  "version": "1.0.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlfieJones/theme-toggles",
    "directory": "packages/svelte"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css"
  },
  "scripts": {
    "generate": "bun run generate.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@theme-toggles/generator": "workspace:*",
    "@theme-toggles/toggles": "workspace:*",
    "svelte-preprocess": "^6.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  }
}
