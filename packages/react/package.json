{
  "name": "@theme-toggles/react",
  "version": "5.0.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlfieJones/theme-toggles",
    "directory": "packages/react"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css"
  },
  "scripts": {
    "generate": "bun run generate.ts",
    "build": "bun run build.ts",
    "shadcn:build": "shadcn build --output ../../website/public/r",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@theme-toggles/generator": "workspace:*",
    "@theme-toggles/toggles": "workspace:*",
    "@types/react": "^19.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  }
}
