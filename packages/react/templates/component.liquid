import {
  type ButtonHTMLAttributes,
  type CSSProperties,
{% if clips.size > 0 %}  useId,
{% endif %}
} from "react";

export interface {{ name }}Props extends Omit<ButtonHTMLAttributes<HTMLButtonElement>, "children"> {
  duration?: number;
  /** Whether the toggle should render in its dark-theme state. */
  toggled?: boolean;
  [key: `data-${string}`]: string | number | boolean | null | undefined;
}

export function {{ name }}({
  duration = {{ defaultDuration }},
  toggled,
  className,
  type = "button",
  title = "Toggle theme",
  "aria-label": ariaLabel = "Toggle theme",
  ...props
}: {{ name }}Props) {
{% if clips.size > 0 %}
  const toggleId = useId();
{% endif %}
{% for clip in clips %}
  const {{ clip.varName }} = `toggles.dev-{{ slug }}-{{ clip.id }}-${toggleId}`;
{% endfor %}

  return (
    <button
      type={type}
      title={title}
      aria-label={ariaLabel}
      aria-pressed={toggled}
      className={[className, toggled === true ? "dark" : toggled === false ? "light" : undefined]
        .filter(Boolean)
        .join(" ")}
      {...props}
    >
{{ svg }}
    </button>
  );
}
