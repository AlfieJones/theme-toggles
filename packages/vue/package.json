{
  "name": "@theme-toggles/vue",
  "version": "1.0.3",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlfieJones/theme-toggles",
    "directory": "packages/vue"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles/*.css": "./dist/styles/*.css"
  },
  "scripts": {
    "generate": "bun run generate.ts",
    "build": "bun run build.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@theme-toggles/generator": "workspace:*",
    "@theme-toggles/toggles": "workspace:*",
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
